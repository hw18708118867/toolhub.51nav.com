---
import ToolLayout from '../../../layouts/ToolLayout.astro'
import StatusMessage from '../../../components/StatusMessage.astro'
import { tools } from '../../../data/tools'

const tool = tools.find(t => t.id === 'aes-encrypt')!

const steps = [
  { name: 'Enter Text & Key', text: 'Type or paste the text into the left panel and enter a secret passphrase. Use at least 16 characters — the strength meter shows how much entropy your key provides. Keep the key safe: without it, decryption is impossible.' },
  { name: 'Pick Algorithm Options', text: 'Choose the key size (AES-128, AES-192 or AES-256), the block mode (GCM recommended, CBC for compatibility with other tools) and the output encoding (Base64 or Hex). PBKDF2 iterations control how expensive a brute-force attack is.' },
  { name: 'Encrypt or Decrypt', text: 'Click "Encrypt" to turn your text into ciphertext, or paste ciphertext and click "Decrypt". The output format stores the salt, IV and algorithm settings, so decryption only needs the correct passphrase.' },
  { name: 'Copy the Result', text: 'Click "Copy" to copy the ciphertext. Use "Swap" to move the output back into the input for round-trip testing. Everything runs locally in your browser — nothing is uploaded.' },
]

const faq = [
  { question: 'What is AES encryption?', answer: 'AES (Advanced Encryption Standard) is the most widely used symmetric encryption algorithm. It was established by NIST in 2001 and is used worldwide to protect classified information, secure web traffic (TLS), encrypt files and protect databases. AES uses the same key for encryption and decryption — symmetric encryption. This tool derives a 128, 192 or 256-bit key from your passphrase using PBKDF2-SHA256 with a random per-message salt.' },
  { question: 'What is the difference between AES-128, AES-192 and AES-256?', answer: 'The number refers to the key length in bits. AES-256 uses a 256-bit key (32 bytes) and provides the largest security margin; AES-192 uses 24 bytes and AES-128 uses 16 bytes. All three are considered secure against classical attacks today. AES-256 is the most conservative choice against future quantum attacks (Grover\'s algorithm halves the effective key length, leaving AES-256 with a 128-bit margin). AES-128 is slightly faster and is sufficient for most applications.' },
  { question: 'Should I use GCM or CBC mode?', answer: 'Use AES-GCM whenever you can. GCM is an authenticated (AEAD) mode: it produces an authentication tag alongside the ciphertext, so tampering or a wrong key is detected reliably and decryption fails loudly. AES-CBC only provides confidentiality — it detects neither tampering nor a wrong key, so a wrong passphrase usually yields garbage output instead of an error. CBC is offered only for compatibility with older systems and libraries (for example CryptoJS defaults). If you must use CBC, authenticate the ciphertext separately with an HMAC.' },
  { question: 'How is my passphrase turned into a key?', answer: 'Your passphrase is stretched with PBKDF2-HMAC-SHA256 using a fresh 16-byte random salt generated for every encryption, and 250,000 iterations by default (you can raise this to 600,000 or 1,000,000). Because the salt is random per message, the same passphrase produces a different key every time, which defeats precomputed rainbow tables. The salt is stored in the output so decryption can reproduce the key. Note that PBKDF2 protects against brute-force, but a weak passphrase is still weak — use a long random key, or generate one with the "Generate" button.' },
  { question: 'Is browser-based encryption secure?', answer: 'This tool uses the Web Crypto API (crypto.subtle), which provides native, hardware-accelerated AES in the browser, and the cryptography itself is sound. All processing happens locally — nothing is sent to a server. However, browser-based encryption has inherent risks: your key sits in memory, the page could be compromised by XSS, and malicious browser extensions could intercept data. For truly sensitive data, use a dedicated encryption application rather than a web tool.' },
  { question: 'Can I decrypt text that was encrypted by another tool?', answer: 'Only if the other tool uses the exact same construction. This tool packs salt, IV, algorithm parameters and ciphertext into one binary blob and Base64/Hex encodes it — that layout is specific to this page. Standard OpenSSL "enc" output starts with the bytes "Salted__" and uses a different KDF (or MD5 in legacy mode), so it will not decrypt here. If you need cross-tool compatibility, use a command-line tool such as OpenSSL where you control every parameter explicitly.' },
]

const before = 'The quick brown fox jumps over the lazy dog. 🦊'
const after = 'AgIA7QFVkF3mQp2sVb8xLrT4nHcE... (Base64 of salt + IV + ciphertext)'
---

<ToolLayout tool={tool} description="Free online AES encrypt/decrypt tool. Encrypt text with AES-128, AES-192 or AES-256 in GCM or CBC mode. PBKDF2 key derivation with a random per-message salt. All processing is local and private." {steps} {faq}>

  <div class="grid lg:grid-cols-2 gap-6 mb-6">
    <div class="code-panel">
      <div class="code-panel-header">
        <span class="text-sm font-medium text-gray-500 dark:text-gray-400" id="inputLabel">Plaintext / Ciphertext</span>
        <button id="copyInputBtn" class="btn btn-sm btn-secondary">Copy</button>
      </div>
      <textarea id="aesInput" class="code-input" placeholder="Enter text to encrypt, or paste ciphertext to decrypt..."></textarea>
    </div>
    <div class="code-panel">
      <div class="code-panel-header">
        <span class="text-sm font-medium text-gray-500 dark:text-gray-400" id="outputLabel">Output</span>
        <button id="copyOutputBtn" class="btn btn-sm btn-secondary">Copy</button>
      </div>
      <pre id="aesOutput" class="code-output">Enter text and a key, then click Encrypt or Decrypt.</pre>
    </div>
  </div>

  <div class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <label for="aesKey" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Secret Key / Passphrase</label>
      <div class="flex items-center gap-2">
        <span id="keyStrength" class="text-xs text-gray-500 dark:text-gray-400"></span>
        <button id="genKeyBtn" class="btn btn-sm btn-secondary">Generate</button>
        <button id="toggleKeyBtn" class="btn btn-sm btn-secondary">Show</button>
      </div>
    </div>
    <input type="password" id="aesKey" class="w-full bg-white border border-gray-200 text-gray-900 rounded-lg px-4 py-3 text-sm font-mono dark:bg-gray-900 dark:border-gray-800 dark:text-gray-100" placeholder="Enter encryption key (16+ characters recommended)...">
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
    <div>
      <label for="keySize" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Key Size</label>
      <select id="keySize" class="w-full bg-white border border-gray-200 text-gray-900 rounded-lg px-3 py-2 text-sm dark:bg-gray-900 dark:border-gray-800 dark:text-gray-100">
        <option value="256" selected>AES-256 (recommended)</option>
        <option value="192">AES-192</option>
        <option value="128">AES-128</option>
      </select>
    </div>
    <div>
      <label for="mode" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Mode</label>
      <select id="mode" class="w-full bg-white border border-gray-200 text-gray-900 rounded-lg px-3 py-2 text-sm dark:bg-gray-900 dark:border-gray-800 dark:text-gray-100">
        <option value="AES-GCM" selected>GCM (authenticated)</option>
        <option value="AES-CBC">CBC (compatibility)</option>
      </select>
    </div>
    <div>
      <label for="encoding" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Output</label>
      <select id="encoding" class="w-full bg-white border border-gray-200 text-gray-900 rounded-lg px-3 py-2 text-sm dark:bg-gray-900 dark:border-gray-800 dark:text-gray-100">
        <option value="base64" selected>Base64</option>
        <option value="hex">Hex</option>
      </select>
    </div>
    <div>
      <label for="iterations" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">PBKDF2 Iterations</label>
      <select id="iterations" class="w-full bg-white border border-gray-200 text-gray-900 rounded-lg px-3 py-2 text-sm dark:bg-gray-900 dark:border-gray-800 dark:text-gray-100">
        <option value="250000" selected>250,000 (default)</option>
        <option value="600000">600,000 (OWASP)</option>
        <option value="1000000">1,000,000 (slow)</option>
      </select>
    </div>
  </div>

  <p id="modeHint" class="mb-6 text-xs text-gray-500 dark:text-gray-400"></p>

  <div class="flex flex-wrap gap-3 mb-6">
    <button id="encryptBtn" class="btn btn-primary">Encrypt</button>
    <button id="decryptBtn" class="btn btn-secondary">Decrypt</button>
    <button id="swapBtn" class="btn btn-secondary">Swap</button>
    <button id="sampleBtn" class="btn btn-secondary">Load Sample</button>
    <button id="clearBtn" class="btn btn-secondary">Clear</button>
  </div>

  <details class="mb-6 bg-white border border-gray-200 rounded-xl overflow-hidden dark:bg-gray-900 dark:border-gray-800">
    <summary class="flex items-center justify-between px-5 py-3 cursor-pointer hover:bg-gray-50 transition-colors list-none text-sm text-gray-600 dark:text-gray-400 dark:hover:bg-gray-800">
      <span>Advanced: legacy v1 format (fixed salt)</span>
      <svg class="w-4 h-4 text-gray-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="px-5 pb-4">
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" id="legacy" class="mt-1">
        <span class="text-xs text-gray-500 dark:text-gray-400">Decrypt ciphertext produced by the old version of this tool (fixed salt <code class="font-mono">aes-tool-salt</code>, 100,000 iterations, AES-256-GCM only, 12-byte IV prefix). This format is weaker — do not use it for new data.</span>
      </label>
    </div>
  </details>

  <StatusMessage id="aesStatus" />

  <section slot="examples" class="mb-10">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 dark:text-white">Examples</h2>
    <div class="grid lg:grid-cols-2 gap-6">
      <div>
        <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3 dark:text-gray-400">Before (Plain Text)</h3>
        <pre class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm text-gray-700 overflow-x-auto dark:bg-gray-900 dark:border-gray-800 dark:text-gray-300"><code>{before}</code></pre>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-green-600 uppercase tracking-wider mb-3">After (AES-256-GCM, Base64)</h3>
        <pre class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm text-gray-700 overflow-x-auto break-all dark:bg-gray-900 dark:border-gray-800 dark:text-gray-300"><code>{after}</code></pre>
        <p class="text-xs text-gray-500 mt-2 dark:text-gray-400">Ciphertext changes on every run because the salt and IV are random.</p>
      </div>
    </div>
  </section>

  <section slot="tutorial" class="mb-10">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 dark:text-white">Understanding AES Encryption</h2>
    <div class="prose prose-gray max-w-none dark:prose-invert">
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-4">AES is a block cipher: it encrypts data in fixed 16-byte blocks using a secret key. A <em>mode of operation</em> describes how to chain those blocks together to encrypt a message of any length, and an <em>initialization vector</em> (IV) makes sure the same plaintext never produces the same ciphertext twice. The IV is not secret — it is stored alongside the ciphertext — but it must never be reused with the same key.</p>

      <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3 dark:text-white">GCM vs CBC</h3>
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-4">AES-GCM is an AEAD mode. Besides encrypting, it computes a 128-bit authentication tag over the ciphertext, so any modification — or a wrong key — causes decryption to fail with an error. AES-CBC only hides the content. It cannot tell you whether the ciphertext was altered or whether you typed the right passphrase, which is why a wrong CBC passphrase often produces mojibake instead of an error. Prefer GCM unless you need to interoperate with a system that only speaks CBC.</p>

      <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3 dark:text-white">From Passphrase to Key: PBKDF2</h3>
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-4">People remember passphrases, but AES needs a fixed-length key of exactly 16, 24 or 32 bytes. PBKDF2-HMAC-SHA256 bridges that gap: it hashes the passphrase together with a random 16-byte salt, repeatedly, for a configurable number of iterations. The salt ensures two encryptions of the same message under the same passphrase are unrelated, which is what makes precomputed rainbow tables useless. The iteration count deliberately slows down each guess — 250,000 iterations is the default here, and you can raise it to 1,000,000 if you can tolerate the delay.</p>

      <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3 dark:text-white">Output Format</h3>
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-4">The result of an encryption is a single binary blob that is then Base64 or Hex encoded:</p>
      <pre class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm text-gray-700 overflow-x-auto dark:bg-gray-900 dark:border-gray-800 dark:text-gray-300"><code>[version 0x02][key size][iterations][mode][salt 16B][IV 12B or 16B][ciphertext]</code></pre>
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed mt-4 mb-4">Because the algorithm parameters travel with the data, decryption only needs the passphrase — you do not have to remember which key size or mode you picked. This layout is specific to this tool, so it is not interchangeable with OpenSSL or CryptoJS output.</p>

      <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3 dark:text-white">Security Notes</h3>
      <ul class="list-disc list-inside space-y-2 text-gray-500 dark:text-gray-400">
        <li>Encryption runs entirely in your browser via the Web Crypto API — no key, plaintext or ciphertext leaves your device.</li>
        <li>A strong passphrase matters more than the key size. Use the "Generate" button to create a random 24-character key and store it in a password manager.</li>
        <li>If you lose the key, the data is unrecoverable. There is no reset or backdoor.</li>
        <li>Never reuse the same key and IV pair. This tool generates a fresh random IV for every encryption.</li>
        <li>AES protects data at rest or in transit; it does not protect you if the machine doing the encryption is already compromised.</li>
      </ul>
    </div>
  </section>

  <section slot="relatedArticles" class="mb-10"><h2 class="text-2xl font-bold text-gray-900 mb-6 dark:text-white">Related Articles</h2><div class="space-y-3">
      <a href="/guides/aes-encryption-guide/" class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md transition-all group dark:bg-gray-900 dark:border-gray-800 dark:hover:border-blue-600"><div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all dark:bg-blue-600/20 dark:text-blue-400"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></div><div class="flex-1 min-w-0"><span class="text-xs text-blue-500 font-medium">Guide</span><h4 class="text-sm font-semibold text-gray-900 mt-0.5 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">AES Encryption Explained</h4><p class="text-xs text-gray-500 mt-0.5 dark:text-gray-400 truncate">How Rijndael works, block cipher modes, IV reuse, padding oracles, PBKDF2.</p></div><svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 flex-shrink-0 transition-colors dark:text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
      <a href="/guides/crypto-tools-guide/" class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md transition-all group dark:bg-gray-900 dark:border-gray-800 dark:hover:border-blue-600"><div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all dark:bg-blue-600/20 dark:text-blue-400"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg></div><div class="flex-1 min-w-0"><span class="text-xs text-blue-500 font-medium">Guide</span><h4 class="text-sm font-semibold text-gray-900 mt-0.5 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">Crypto Tools Guide</h4><p class="text-xs text-gray-500 mt-0.5 dark:text-gray-400 truncate">Hashing, HMAC, encryption and password security.</p></div><svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 flex-shrink-0 transition-colors dark:text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="/tools/password-generator/" class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md transition-all group dark:bg-gray-900 dark:border-gray-800 dark:hover:border-blue-600"><div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all dark:bg-blue-600/20 dark:text-blue-400"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg></div><div class="flex-1 min-w-0"><span class="text-xs text-green-500 font-medium">Tool</span><h4 class="text-sm font-semibold text-gray-900 mt-0.5 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">Password Generator</h4><p class="text-xs text-gray-500 mt-0.5 dark:text-gray-400 truncate">Create strong random keys for AES encryption.</p></div><svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 flex-shrink-0 transition-colors dark:text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="/tools/hash-generator/" class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md transition-all group dark:bg-gray-900 dark:border-gray-800 dark:hover:border-blue-600"><div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all dark:bg-blue-600/20 dark:text-blue-400"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg></div><div class="flex-1 min-w-0"><span class="text-xs text-green-500 font-medium">Tool</span><h4 class="text-sm font-semibold text-gray-900 mt-0.5 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">Hash Generator</h4><p class="text-xs text-gray-500 mt-0.5 dark:text-gray-400 truncate">MD5, SHA-1, SHA-256, SHA-512.</p></div><svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 flex-shrink-0 transition-colors dark:text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="/tools/hmac-generator/" class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md transition-all group dark:bg-gray-900 dark:border-gray-800 dark:hover:border-blue-600"><div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all dark:bg-blue-600/20 dark:text-blue-400"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg></div><div class="flex-1 min-w-0"><span class="text-xs text-green-500 font-medium">Tool</span><h4 class="text-sm font-semibold text-gray-900 mt-0.5 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">HMAC Generator</h4><p class="text-xs text-gray-500 mt-0.5 dark:text-gray-400 truncate">Generate HMAC with SHA-256 and SHA-512.</p></div><svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 flex-shrink-0 transition-colors dark:text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
    <a href="/tools/rsa-key-generator/" class="flex items-center gap-4 p-4 bg-white border border-gray-200 rounded-xl hover:border-blue-500 hover:shadow-md transition-all group dark:bg-gray-900 dark:border-gray-800 dark:hover:border-blue-600"><div class="w-9 h-9 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all dark:bg-blue-600/20 dark:text-blue-400"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1m2 13a2 2 0 0 1-2-2V7m2 13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg></div><div class="flex-1 min-w-0"><span class="text-xs text-green-500 font-medium">Tool</span><h4 class="text-sm font-semibold text-gray-900 mt-0.5 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 transition-colors">RSA Key Generator</h4><p class="text-xs text-gray-500 mt-0.5 dark:text-gray-400 truncate">Generate RSA public/private key pairs.</p></div><svg class="w-5 h-5 text-gray-300 group-hover:text-blue-500 flex-shrink-0 transition-colors dark:text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></a>
  </div></section>

  <script>
    import { copyToClipboard } from '../../../utils/copyToClipboard'

    const aesInput = document.getElementById('aesInput') as HTMLTextAreaElement
    const aesKey = document.getElementById('aesKey') as HTMLInputElement
    const aesOutput = document.getElementById('aesOutput')!
    const keySizeSel = document.getElementById('keySize') as HTMLSelectElement
    const modeSel = document.getElementById('mode') as HTMLSelectElement
    const encodingSel = document.getElementById('encoding') as HTMLSelectElement
    const iterationsSel = document.getElementById('iterations') as HTMLSelectElement
    const legacyEl = document.getElementById('legacy') as HTMLInputElement
    const keyStrengthEl = document.getElementById('keyStrength')!
    const modeHint = document.getElementById('modeHint')!
    const inputLabel = document.getElementById('inputLabel')!
    const outputLabel = document.getElementById('outputLabel')!
    const toggleKeyBtn = document.getElementById('toggleKeyBtn')!

    const PLACEHOLDER = aesOutput.textContent || ''
    const enc = new TextEncoder()
    const dec = new TextDecoder('utf-8', { fatal: true })

    const KEY_SIZES = [128, 192, 256]
    const ITERATIONS = [250000, 600000, 1000000]
    const MODES = ['AES-GCM', 'AES-CBC']
    const SALT_LEN = 16
    const VERSION = 2
    const LEGACY_SALT = 'aes-tool-salt'
    const LEGACY_ITERATIONS = 100000

    function showStatus(message: string, type: 'success' | 'error') {
      const statusEl = document.getElementById('aesStatus')!
      statusEl.textContent = message
      statusEl.classList.remove('hidden')
      statusEl.className = type === 'success'
        ? 'mt-4 px-4 py-3 rounded-lg bg-green-900/40 border border-green-800 text-green-400'
        : 'mt-4 px-4 py-3 rounded-lg bg-red-900/40 border border-red-800 text-red-400'
      setTimeout(() => statusEl.classList.add('hidden'), 4000)
    }

    /* ---------- chunk-safe binary <-> text conversion ---------- */
    function bytesToBase64(bytes: Uint8Array): string {
      let binary = ''
      const CHUNK = 0x8000
      for (let i = 0; i < bytes.length; i += CHUNK) {
        binary += String.fromCharCode(...bytes.subarray(i, i + CHUNK))
      }
      return btoa(binary)
    }

    function base64ToBytes(b64: string): Uint8Array {
      const binary = atob(b64)
      const out = new Uint8Array(binary.length)
      for (let i = 0; i < binary.length; i++) out[i] = binary.charCodeAt(i)
      return out
    }

    function bytesToHex(bytes: Uint8Array): string {
      let hex = ''
      for (let i = 0; i < bytes.length; i++) hex += bytes[i].toString(16).padStart(2, '0')
      return hex
    }

    function hexToBytes(hex: string): Uint8Array | null {
      const clean = hex.replace(/\s+/g, '')
      if (clean.length === 0 || clean.length % 2 !== 0 || !/^[0-9a-fA-F]+$/.test(clean)) return null
      const out = new Uint8Array(clean.length / 2)
      for (let i = 0; i < out.length; i++) out[i] = parseInt(clean.substr(i * 2, 2), 16)
      return out
    }

    function decodePayload(raw: string): Uint8Array | null {
      const first = encodingSel.value === 'hex' ? 'hex' : 'base64'
      const order = first === 'hex' ? ['hex', 'base64'] : ['base64', 'hex']
      for (const fmt of order) {
        try {
          if (fmt === 'hex') {
            const parsed = hexToBytes(raw)
            if (parsed) return parsed
          } else {
            return base64ToBytes(raw)
          }
        } catch { /* try the other encoding */ }
      }
      return null
    }

    function requiresSecureContext(): boolean {
      if (!window.crypto || !window.crypto.subtle) {
        showStatus('Web Crypto API unavailable. Open this page over HTTPS or on localhost.', 'error')
        return false
      }
      return true
    }

    async function deriveKey(password: string, salt: Uint8Array, length: number, iters: number, alg: string) {
      const base = await crypto.subtle.importKey('raw', enc.encode(password), 'PBKDF2', false, ['deriveKey'])
      return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt, iterations: iters, hash: 'SHA-256' },
        base,
        { name: alg, length },
        false,
        ['encrypt', 'decrypt']
      )
    }

    function ivLengthFor(alg: string): number {
      return alg === 'AES-CBC' ? 16 : 12
    }

    function updateModeHint() {
      if (legacyEl.checked) {
        modeHint.textContent = 'Legacy v1: fixed salt, 100,000 iterations, AES-256-GCM. Use only to decrypt old ciphertext.'
        return
      }
      modeHint.textContent = modeSel.value === 'AES-GCM'
        ? 'GCM authenticates the ciphertext — a wrong key or any tampering is detected and decryption fails.'
        : 'CBC provides no authentication. A wrong key may produce garbled output instead of an error. Use only for interoperability.'
    }

    function updateKeyStrength() {
      const pw = aesKey.value
      if (!pw) {
        keyStrengthEl.textContent = ''
        keyStrengthEl.className = 'text-xs text-gray-500 dark:text-gray-400'
        return
      }
      let pool = 0
      if (/[a-z]/.test(pw)) pool += 26
      if (/[A-Z]/.test(pw)) pool += 26
      if (/[0-9]/.test(pw)) pool += 10
      if (/[^A-Za-z0-9]/.test(pw)) pool += 32
      const bits = Math.round(pw.length * Math.log2(Math.max(pool, 2)))
      if (bits >= 128) {
        keyStrengthEl.textContent = `Strong (~${bits} bits)`
        keyStrengthEl.className = 'text-xs text-green-600 dark:text-green-400'
      } else if (bits >= 90) {
        keyStrengthEl.textContent = `Good (~${bits} bits)`
        keyStrengthEl.className = 'text-xs text-blue-600 dark:text-blue-400'
      } else if (bits >= 60) {
        keyStrengthEl.textContent = `Fair (~${bits} bits)`
        keyStrengthEl.className = 'text-xs text-yellow-600 dark:text-yellow-400'
      } else {
        keyStrengthEl.textContent = `Weak (~${bits} bits)`
        keyStrengthEl.className = 'text-xs text-red-600 dark:text-red-400'
      }
    }

    async function encrypt() {
      if (!requiresSecureContext()) return
      const plaintext = aesInput.value
      const password = aesKey.value
      if (!plaintext) { showStatus('Enter some text to encrypt first.', 'error'); return }
      if (!password) { showStatus('Enter a secret key first.', 'error'); return }

      try {
        const isLegacy = legacyEl.checked
        const length = isLegacy ? 256 : parseInt(keySizeSel.value, 10)
        const iters = isLegacy ? LEGACY_ITERATIONS : parseInt(iterationsSel.value, 10)
        const alg = isLegacy ? 'AES-GCM' : modeSel.value
        const salt = isLegacy ? enc.encode(LEGACY_SALT) : crypto.getRandomValues(new Uint8Array(SALT_LEN))
        const ivLen = ivLengthFor(alg)
        const iv = crypto.getRandomValues(new Uint8Array(ivLen))

        const key = await deriveKey(password, salt, length, iters, alg)
        const ct = new Uint8Array(await crypto.subtle.encrypt({ name: alg, iv }, key, enc.encode(plaintext)))

        const headerLen = isLegacy ? 0 : 4
        const payload = new Uint8Array(headerLen + (isLegacy ? 0 : SALT_LEN) + ivLen + ct.length)
        let offset = 0
        if (!isLegacy) {
          payload[0] = VERSION
          payload[1] = KEY_SIZES.indexOf(length)
          payload[2] = ITERATIONS.indexOf(iters)
          payload[3] = MODES.indexOf(alg)
          payload.set(salt, 4)
          offset = 4 + SALT_LEN
        }
        payload.set(iv, offset)
        payload.set(ct, offset + ivLen)

        aesOutput.textContent = encodingSel.value === 'hex' ? bytesToHex(payload) : bytesToBase64(payload)
        inputLabel.textContent = 'Plaintext'
        outputLabel.textContent = 'Ciphertext'
        showStatus(`Encrypted with AES-${length}-${alg.replace('AES-', '')} using ${iters.toLocaleString()} PBKDF2 iterations.`, 'success')
      } catch (e) {
        showStatus('Encryption failed: ' + (e as Error).message, 'error')
      }
    }

    async function decrypt() {
      if (!requiresSecureContext()) return
      const raw = aesInput.value.trim()
      const password = aesKey.value
      if (!raw) { showStatus('Paste the ciphertext to decrypt first.', 'error'); return }
      if (!password) { showStatus('Enter the secret key used to encrypt.', 'error'); return }

      const data = decodePayload(raw)
      if (!data) { showStatus('Could not parse the input as valid Base64 or Hex.', 'error'); return }

      try {
        const isLegacy = legacyEl.checked
        let length: number, iters: number, alg: string, bodyOffset: number

        if (isLegacy) {
          length = 256
          iters = LEGACY_ITERATIONS
          alg = 'AES-GCM'
          bodyOffset = 0
        } else if (data[0] === VERSION) {
          length = KEY_SIZES[data[1]]
          iters = ITERATIONS[data[2]]
          alg = MODES[data[3]]
          if (!length || !iters || !alg) { showStatus('Ciphertext header is corrupt or from an unsupported version.', 'error'); return }
          bodyOffset = 4
        } else {
          showStatus('Unrecognised format. If this was encrypted with the old version of this tool, enable "legacy v1 format".', 'error')
          return
        }

        const saltLen = isLegacy ? 0 : SALT_LEN
        const ivLen = ivLengthFor(alg)
        if (data.length <= bodyOffset + saltLen + ivLen) {
          showStatus('Ciphertext is too short to contain a valid IV and payload.', 'error')
          return
        }

        const salt = isLegacy ? enc.encode(LEGACY_SALT) : data.slice(bodyOffset, bodyOffset + SALT_LEN)
        const ivStart = bodyOffset + saltLen
        const iv = data.slice(ivStart, ivStart + ivLen)
        const ct = data.slice(ivStart + ivLen)

        const key = await deriveKey(password, salt, length, iters, alg)
        const pt = new Uint8Array(await crypto.subtle.decrypt({ name: alg, iv }, key, ct))
        const text = dec.decode(pt)

        aesOutput.textContent = text
        inputLabel.textContent = 'Ciphertext'
        outputLabel.textContent = 'Plaintext'
        showStatus(`Decrypted with AES-${length}-${alg.replace('AES-', '')}.`, 'success')
      } catch (e) {
        showStatus('Decryption failed — wrong key, wrong options, or the ciphertext was altered.', 'error')
      }
    }

    function generateKey() {
      const bytes = crypto.getRandomValues(new Uint8Array(18))
      aesKey.value = bytesToBase64(bytes)
      aesKey.type = 'text'
      toggleKeyBtn.textContent = 'Hide'
      updateKeyStrength()
      showStatus('Random 24-character key generated. Store it safely — it cannot be recovered.', 'success')
    }

    document.getElementById('encryptBtn')!.addEventListener('click', encrypt)
    document.getElementById('decryptBtn')!.addEventListener('click', decrypt)

    document.getElementById('swapBtn')!.addEventListener('click', () => {
      const out = aesOutput.textContent || ''
      if (!out || out === PLACEHOLDER) { showStatus('Nothing to swap yet.', 'error'); return }
      aesInput.value = out
      aesOutput.textContent = ''
      const l = inputLabel.textContent
      inputLabel.textContent = outputLabel.textContent
      outputLabel.textContent = l
      showStatus('Swapped output into the input panel.', 'success')
    })

    document.getElementById('sampleBtn')!.addEventListener('click', () => {
      aesInput.value = 'The quick brown fox jumps over the lazy dog. 🦊'
      aesKey.value = 'MySecretKey-2026!'
      aesOutput.textContent = ''
      inputLabel.textContent = 'Plaintext / Ciphertext'
      outputLabel.textContent = 'Output'
      updateKeyStrength()
      showStatus('Sample loaded. Click Encrypt to see it work.', 'success')
    })

    document.getElementById('clearBtn')!.addEventListener('click', () => {
      aesInput.value = ''
      aesKey.value = ''
      aesOutput.textContent = ''
      inputLabel.textContent = 'Plaintext / Ciphertext'
      outputLabel.textContent = 'Output'
      updateKeyStrength()
    })

    document.getElementById('genKeyBtn')!.addEventListener('click', generateKey)

    toggleKeyBtn.addEventListener('click', () => {
      const hidden = aesKey.type === 'password'
      aesKey.type = hidden ? 'text' : 'password'
      toggleKeyBtn.textContent = hidden ? 'Hide' : 'Show'
    })

    document.getElementById('copyInputBtn')!.addEventListener('click', async () => {
      const ok = await copyToClipboard(aesInput.value)
      showStatus(ok ? 'Input copied!' : 'Copy failed', ok ? 'success' : 'error')
    })

    document.getElementById('copyOutputBtn')!.addEventListener('click', async () => {
      const out = aesOutput.textContent || ''
      if (!out || out === PLACEHOLDER) { showStatus('Nothing to copy yet.', 'error'); return }
      const ok = await copyToClipboard(out)
      showStatus(ok ? 'Output copied!' : 'Copy failed', ok ? 'success' : 'error')
    })

    aesKey.addEventListener('input', updateKeyStrength)
    modeSel.addEventListener('change', updateModeHint)
    legacyEl.addEventListener('change', updateModeHint)

    updateModeHint()
    updateKeyStrength()
  </script>
</ToolLayout>
