---
import '../styles/globals.css'
import { tools } from '../data/tools'

interface Props {
  title?: string
  description?: string
  ogType?: string
  publishedTime?: string
  modifiedTime?: string
  robots?: string
}

const toolCount = tools.length
const guideCount = Object.keys(import.meta.glob('../pages/guides/*.astro')).filter(p => !p.endsWith('index.astro')).length
const defaultTitle = `DevTools Hub — ${toolCount}+ Free Online Developer Tools`
const defaultDesc = `${toolCount} free online developer tools and ${guideCount} in-depth guides. Everything runs locally in your browser — no uploads, no sign-ups, no limits.`

const {
  title = defaultTitle,
  description = defaultDesc,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props

// Read from environment variables (GitHub Actions secrets / .env file)
// Set PUBLIC_GA4_ID and PUBLIC_GSC_CODE in your repository's CI variables
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || 'G-XXXXXXXXXX'
const GSC_CODE = import.meta.env.PUBLIC_GSC_CODE || 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:image" content="https://toolhub.51nav.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="DevTools Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://toolhub.51nav.com/og-image.png" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="google-site-verification" content={GSC_CODE} />
    <!-- Favicon: SVG for modern browsers, PNG fallback -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <!-- Apple touch icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- Android / PWA -->
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:inline>
      /* Prevent flash of wrong theme on page load */
      html { visibility: hidden; }
      html[class] { visibility: visible; }
    </style>
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersLight = !saved && window.matchMedia('(prefers-color-scheme: light)').matches;
        if (saved === 'light' || prefersLight) {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <!-- Google Analytics (GA4) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ${JSON.stringify(GA4_ID)});
      document.addEventListener('ga-event', function(e) {
        var d = e.detail || {};
        var name = d.name;
        var params = Object.assign({}, d); delete params.name;
        if (typeof gtag === 'function') gtag('event', name || 'interaction', params);
      });
      document.addEventListener('click', function(e) {
        var el = e.target.closest('[data-ga]');
        if (el && typeof gtag === 'function') gtag('event', el.dataset.ga);
      });
    `}></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <div id="reading-progress" class="fixed left-0 top-0 z-[60] h-0.5 w-0 bg-blue-600 transition-[width] duration-100"></div>
    <slot />
  </body>
  <script is:inline>
    (function() {
      const bar = document.getElementById('reading-progress')
      const content = document.getElementById('guide-content')
      if (!bar || !content) return
      function update() {
        const top = content.getBoundingClientRect().top
        const total = Math.max(1, content.offsetHeight - window.innerHeight)
        const progress = Math.min(1, Math.max(0, -top / total))
        bar.style.width = (progress * 100) + '%'
      }
      window.addEventListener('scroll', update, { passive: true })
      update()
    })()
  </script>
</html>