---
/**
 * UrlReservedDemo — clickable grid of printable ASCII characters showing which
 * stay unreserved (RFC 3986: A-Z a-z 0-9 - . _ ~) and which get percent-encoded.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-sm font-semibold text-gray-900 dark:text-white">Which characters survive in a URL?</span>
  </div>
  <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">Click any character to see whether it stays as-is or becomes percent-encoded. Green = unreserved (kept); red = encoded.</p>

  <div id="ur-grid" class="grid grid-cols-8 sm:grid-cols-12 gap-1.5"></div>

  <div class="mt-4 flex flex-wrap items-center gap-4 text-[11px]">
    <span class="inline-flex items-center gap-1"><span class="h-3 w-3 rounded-sm bg-green-100 border border-green-400 dark:bg-green-900/40 dark:border-green-600"></span> Unreserved (kept)</span>
    <span class="inline-flex items-center gap-1"><span class="h-3 w-3 rounded-sm bg-red-100 border border-red-400 dark:bg-red-900/40 dark:border-red-600"></span> Percent-encoded</span>
  </div>

  <div id="ur-detail" class="mt-4 rounded-lg bg-white border border-gray-200 p-3 font-mono text-[12px] break-all min-h-[2.5rem] text-gray-800 dark:bg-gray-950 dark:border-gray-800 dark:text-gray-200"></div>
</div>

<script>
  const $ = (id) => document.getElementById(id)
  const gridEl = $('ur-grid')
  const detailEl = $('ur-detail')

  const UNRESERVED = new Set('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~'.split(''))
  function hexOf(b) { return b.toString(16).padStart(2, '0').toUpperCase() }

  function encodeChar(c) {
    return Array.from(new TextEncoder().encode(c)).map(b => '%' + hexOf(b)).join('')
  }

  const cells = []
  for (let code = 32; code <= 126; code++) {
    const c = String.fromCharCode(code)
    const reserved = !UNRESERVED.has(c)
    const label = c === ' ' ? '␣' : (c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '&' ? '&amp;' : c)
    const cell = document.createElement('button')
    cell.className = 'rounded-lg border px-1 py-2 text-center font-mono text-xs transition ' +
      (reserved
        ? 'border-red-400 bg-red-100 text-red-700 dark:border-red-600 dark:bg-red-900/40 dark:text-red-300'
        : 'border-green-400 bg-green-100 text-green-700 dark:border-green-600 dark:bg-green-900/40 dark:text-green-300')
    cell.innerHTML = '<span>' + label + '</span>'
    cell.addEventListener('click', () => {
      cells.forEach(x => x.classList.remove('ring-2', 'ring-blue-500'))
      cell.classList.add('ring-2', 'ring-blue-500')
      if (reserved) {
        detailEl.innerHTML = "<span class='text-gray-500'>code 0x" + code.toString(16).toUpperCase() + " (" + (c === ' ' ? 'space' : c) + ") &rarr; </span>" +
          "<span class='text-blue-600 dark:text-blue-400'>" + encodeChar(c) + "</span>"
      } else {
        detailEl.innerHTML = "<span class='text-gray-500'>code 0x" + code.toString(16).toUpperCase() + " (" + c + ") is unreserved &rarr; </span><span class='text-green-600 dark:text-green-400'>" + c + " (kept)</span>"
      }
    })
    cells.push(cell)
    gridEl.appendChild(cell)
  }

  detailEl.textContent = 'Click a character above to inspect it.'
</script>
