---
/**
 * Flip one bit of a real AES-GCM and AES-CBC ciphertext and watch what
 * happens on decryption. GCM refuses; CBC silently returns corrupted data.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
      </svg>
      <span class="text-sm font-semibold text-gray-900 dark:text-white">Authenticated Encryption — Tamper Test</span>
    </div>
    <div class="ml-auto flex gap-2">
      <button id="tmFlip" class="rounded-lg bg-red-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-red-700">Flip one bit</button>
      <button id="tmReset" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">↺ Reset</button>
    </div>
  </div>

  <div class="mb-4 text-[13px] leading-6 text-gray-600 dark:text-gray-400">
    The same 32-byte message is encrypted twice — once with AES-256-GCM and once with AES-256-CBC — using
    real Web Crypto. Now flip a single bit of each ciphertext and decrypt. This is the practical
    difference between an AEAD mode and a confidentiality-only mode.
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-emerald-200 bg-white p-3 dark:border-emerald-900 dark:bg-gray-900">
      <div class="mb-2 flex items-center gap-2">
        <span class="rounded bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">AES-256-GCM</span>
        <span class="text-[11px] text-gray-400 dark:text-gray-500">authenticated</span>
      </div>
      <div id="tmGcm" class="space-y-2 font-mono text-[11px]"></div>
    </div>

    <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-900 dark:bg-gray-900">
      <div class="mb-2 flex items-center gap-2">
        <span class="rounded bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">AES-256-CBC</span>
        <span class="text-[11px] text-gray-400 dark:text-gray-500">confidentiality only</span>
      </div>
      <div id="tmCbc" class="space-y-2 font-mono text-[11px]"></div>
    </div>
  </div>

  <div id="tmVerdict" class="mt-4"></div>
</div>

<script>
  const $ = (id: string) => document.getElementById(id)! as HTMLElement
  const enc = new TextEncoder()
  const dec = new TextDecoder()
  const hex = (b: number) => b.toString(16).padStart(2, '0')
  const toHex = (b: Uint8Array) => Array.from(b).map(hex).join('')

  // Web Crypto's AES-CBC does not add padding itself: the plaintext must already
  // be a whole number of 16-byte blocks, so pad to two blocks with spaces.
  const MESSAGE = 'Transfer $100.00 to Bob'.padEnd(32, ' ')
  const GCM_NONCE = new Uint8Array(12).fill(0x0c)
  const CBC_IV = new Uint8Array(16).fill(0x0c)

  let gcmKey: CryptoKey | null = null
  let cbcKey: CryptoKey | null = null
  let gcmCt = new Uint8Array(0)
  let cbcCt = new Uint8Array(0)
  let flipped = false

  async function setup() {
    if (gcmKey) return
    const material = new Uint8Array(32).fill(0x4b)
    gcmKey = await crypto.subtle.importKey('raw', material, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt'])
    cbcKey = await crypto.subtle.importKey('raw', material, { name: 'AES-CBC' }, false, ['encrypt', 'decrypt'])
    const pt = enc.encode(MESSAGE)
    gcmCt = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv: GCM_NONCE }, gcmKey, pt))
    cbcCt = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-CBC', iv: CBC_IV }, cbcKey, pt))
  }

  function line(label: string, value: string, tone = 'text-gray-500 dark:text-gray-400') {
    return `<div><span class="text-gray-400 dark:text-gray-500">${label}</span> <span class="break-all ${tone}">${value}</span></div>`
  }

  function showHex(b: Uint8Array, highlight = -1) {
    return Array.from(b).map((v, i) =>
      i === highlight
        ? `<span class="bg-red-500 font-bold text-white">${hex(v)}</span>`
        : hex(v)
    ).join('')
  }

  function escapeHtml(s: string) {
    return s.replace(/[<>&]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!)
  }

  /** Replace non-printable bytes with · so garbage output is readable. */
  function readable(b: Uint8Array) {
    return Array.from(b).map(v => (v >= 0x20 && v <= 0x7e ? String.fromCharCode(v) : '·')).join('')
  }

  async function render() {
    await setup()
    const payloadGcm = flipped ? flipFirstBit(gcmCt) : gcmCt
    const payloadCbc = flipped ? flipFirstBit(cbcCt) : cbcCt

    // GCM: the last 16 bytes are the authentication tag
    const gcmBody = payloadGcm.subarray(0, payloadGcm.length - 16)
    const gcmTag = payloadGcm.subarray(payloadGcm.length - 16)

    let gcmOut: string
    try {
      const pt = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: GCM_NONCE }, gcmKey!, payloadGcm))
      gcmOut = line('decrypted:', `"${escapeHtml(dec.decode(pt))}"`, 'text-emerald-600 dark:text-emerald-400 font-semibold')
    } catch (e) {
      gcmOut = `<div class="rounded bg-red-50 px-2 py-1.5 text-red-700 dark:bg-red-900/30 dark:text-red-300">
        <div class="font-sans text-[12px] font-semibold">REJECTED — ${(e as Error).name}</div>
        <div class="mt-0.5 font-sans text-[11px] leading-snug">The authentication tag did not verify. No plaintext was returned, so nothing corrupted can reach your application.</div>
      </div>`
    }

    $('tmGcm').innerHTML =
      line('ciphertext:', showHex(gcmBody, flipped ? 0 : -1)) +
      line('tag:', showHex(gcmTag)) +
      gcmOut

    let cbcOut: string
    try {
      const pt = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-CBC', iv: CBC_IV }, cbcKey!, payloadCbc))
      const b1 = readable(pt.subarray(0, 16))
      const b2 = readable(pt.subarray(16, 32))
      const damaged = b1 !== MESSAGE.slice(0, 16)
      cbcOut = damaged
        ? `<div class="rounded bg-red-50 px-2 py-1.5 text-red-700 dark:bg-red-900/30 dark:text-red-300">
            <div class="font-sans text-[12px] font-semibold">ACCEPTED — but the data is corrupted</div>
            <div class="mt-1 font-mono text-[11px]">block 1: <span class="font-bold">${escapeHtml(b1)}</span></div>
            <div class="mt-0.5 font-mono text-[11px]">block 2: ${escapeHtml(b2)}</div>
            <div class="mt-1 font-sans text-[11px] leading-snug">No error was raised. Block 1 is destroyed and one byte of block 2 flipped with it — CBC decrypt uses C₁ to unmask block 2. Your application would carry on as if nothing happened.</div>
          </div>`
        : line('decrypted:', `"${escapeHtml(dec.decode(pt))}"`, 'text-emerald-600 dark:text-emerald-400 font-semibold')
    } catch (e) {
      cbcOut = `<div class="rounded bg-red-50 px-2 py-1.5 text-red-700 dark:bg-red-900/30 dark:text-red-300">REJECTED — ${(e as Error).name}</div>`
    }

    $('tmCbc').innerHTML = line('ciphertext:', showHex(payloadCbc, flipped ? 0 : -1)) + cbcOut

    $('tmVerdict').innerHTML = flipped
      ? `<div class="rounded-lg border-l-4 border-blue-500 bg-blue-50/60 px-4 py-3 text-[13px] leading-6 text-blue-900 dark:bg-blue-950/30 dark:text-blue-200">
          Same single-bit change, two completely different outcomes. GCM verifies the tag before releasing
          any plaintext, so the tampering is caught and reported. CBC has no integrity check at all: it
          decrypts the modified data and hands back something that looks legitimate. If you must use CBC,
          compute an HMAC over the ciphertext and verify it <em>before</em> decrypting — encrypt-then-MAC.
        </div>`
      : `<div class="rounded-lg border border-gray-200 bg-white px-4 py-3 text-[13px] leading-6 text-gray-500 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400">
          Original ciphertext of "${escapeHtml(MESSAGE)}" (padded to 32 bytes). Press “Flip one bit” to
          modify the first byte of each ciphertext.
        </div>`
  }

  function flipFirstBit(src: Uint8Array) {
    const out = Uint8Array.from(src)
    out[0] ^= 0x01
    return out
  }

  $('tmFlip').addEventListener('click', () => { flipped = true; render() })
  $('tmReset').addEventListener('click', () => { flipped = false; render() })

  render()
</script>
