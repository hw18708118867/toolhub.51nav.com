---
/**
 * Base64PaddingDemo — real computation of how 1- and 2-byte inputs are padded
 * with "=" to reach a multiple of four characters. Step through each case.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-sm font-semibold text-gray-900 dark:text-white">Why the "=" shows up</span>
  </div>
  <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">Base64 output must land on a 4-character boundary. When the last group has only 1 or 2 bytes, padding characters "=" fill the gap. Real computation below.</p>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <button id="bp-reset" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">⟲ Reset</button>
    <button id="bp-prev" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">‹ Prev</button>
    <button id="bp-play" class="rounded-lg border border-blue-500 bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700">▶ Play</button>
    <button id="bp-next" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">Next ›</button>
    <input id="bp-speed" type="range" min="400" max="2000" step="100" value="1000" class="ml-1 w-28 accent-blue-600" />
  </div>

  <div id="bp-progress" class="mb-4 h-1.5 w-full rounded-full bg-gray-200 dark:bg-gray-800">
    <div class="h-full rounded-full bg-blue-600 transition-all" style="width:0%"></div>
  </div>

  <div id="bp-card" class="rounded-lg border border-gray-300 bg-white p-4 text-sm dark:border-gray-700 dark:bg-gray-950"></div>

  <div id="bp-explain" class="mt-4 text-[13px] leading-6 text-gray-600 dark:text-gray-400"></div>
  <div id="bp-timeline" class="mt-4 flex flex-wrap gap-1.5"></div>
</div>

<script>
  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

  function encode(bytes) {
    const out = []
    for (let i = 0; i < bytes.length; i += 3) {
      const b0 = bytes[i]
      const b1 = i + 1 < bytes.length ? bytes[i + 1] : 0
      const b2 = i + 2 < bytes.length ? bytes[i + 2] : 0
      const have = bytes.length - i // 1, 2 or 3
      const v = (b0 << 16) | (b1 << 8) | b2
      out.push(B64[(v >> 18) & 63])
      out.push(B64[(v >> 12) & 63])
      if (have >= 2) out.push(B64[(v >> 6) & 63])
      if (have === 3) out.push(B64[v & 63])
      if (have === 2) out.push('=')
      if (have === 1) { out.push('='); out.push('=') }
    }
    return out.join('')
  }

  const cases = [
    { label: 'One byte: "M"', bytes: [0x4d], note: 'The 8 bits become two 6-bit groups (12 bits). The last two slots are padding, so the result ends with "==".' },
    { label: 'Two bytes: "Ma"', bytes: [0x4d, 0x61], note: '16 bits become three 6-bit groups (18 bits). One slot is left, so one "=" is appended.' },
    { label: 'Three bytes: "Man"', bytes: [0x4d, 0x61, 0x6e], note: '24 bits fill all four slots exactly. No padding needed.' },
  ].map((c) => ({ ...c, result: encode(c.bytes) }))

  let idx = 0
  let timer = null
  const $ = (id) => document.getElementById(id)
  const cardEl = $('bp-card'), explainEl = $('bp-explain')
  const progressEl = $('bp-progress').firstElementChild, timelineEl = $('bp-timeline')
  const playBtn = $('bp-play')

  function render() {
    const c = cases[idx]
    const padded = (c.result.match(/=/g) || []).length
    cardEl.innerHTML =
      '<div class="font-semibold text-gray-900 dark:text-white">' + c.label + '</div>' +
      '<div class="mt-2 text-gray-600 dark:text-gray-400">hex: <code class="font-mono">' + c.bytes.map((b) => '0x' + b.toString(16)).join(' ') + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400">Base64: <code class="font-mono text-lg font-bold text-blue-600 dark:text-blue-400">' + c.result + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400">padding "=" count: <code class="font-mono text-rose-600 dark:text-rose-400">' + padded + '</code></div>'
    explainEl.textContent = (idx + 1) + '/' + cases.length + ' · ' + c.note
    progressEl.style.width = ((idx + 1) / cases.length) * 100 + '%'
    ;[...timelineEl.children].forEach((el, k) => el.classList.toggle('bg-blue-600', k === idx))
  }

  function buildTimeline() {
    timelineEl.innerHTML = cases.map((_, k) =>
      '<button class="h-2 w-2 rounded-full bg-gray-300 dark:bg-gray-600" data-i="' + k + '"></button>'
    ).join('')
    timelineEl.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => { pause(); idx = +b.dataset.i; render() }))
  }
  function play() {
    if (timer) return
    playBtn.textContent = '⏸ Pause'
    timer = setInterval(() => { if (idx >= cases.length - 1) { pause(); return } idx++; render() }, +$('bp-speed').value)
  }
  function pause() { clearInterval(timer); timer = null; playBtn.textContent = '▶ Play' }

  $('bp-reset').addEventListener('click', () => { pause(); idx = 0; render() })
  $('bp-prev').addEventListener('click', () => { pause(); idx = Math.max(0, idx - 1); render() })
  $('bp-next').addEventListener('click', () => { pause(); idx = Math.min(cases.length - 1, idx + 1); render() })
  playBtn.addEventListener('click', () => (timer ? pause() : play()))
  $('bp-speed').addEventListener('input', () => { if (timer) { pause(); play() } })

  new IntersectionObserver((es, ob) => {
    es.forEach((e) => { if (e.isIntersecting) { render(); ob.disconnect() } })
  }, { threshold: 0.4 }).observe(cardEl)

  buildTimeline()
  render()
</script>
