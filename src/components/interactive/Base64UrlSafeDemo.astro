---
/**
 * Base64UrlSafeDemo — real computation showing the URL-safe alphabet swap
 * (+ -> -, / -> _) and dropping the trailing "=" padding so the result is safe
 * inside URLs and filenames.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-sm font-semibold text-gray-900 dark:text-white">Base64 vs URL-safe Base64</span>
  </div>
  <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">"+" and "/" are special in URLs and filenames; "=" can be trimmed. The URL-safe variant swaps two characters and drops padding. Computed live.</p>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <button id="bu-reset" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">⟲ Reset</button>
    <button id="bu-prev" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">‹ Prev</button>
    <button id="bu-play" class="rounded-lg border border-blue-500 bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700">▶ Play</button>
    <button id="bu-next" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">Next ›</button>
    <input id="bu-speed" type="range" min="400" max="2000" step="100" value="1000" class="ml-1 w-28 accent-blue-600" />
  </div>

  <div id="bu-progress" class="mb-4 h-1.5 w-full rounded-full bg-gray-200 dark:bg-gray-800">
    <div class="h-full rounded-full bg-blue-600 transition-all" style="width:0%"></div>
  </div>

  <div id="bu-card" class="rounded-lg border border-gray-300 bg-white p-4 text-sm dark:border-gray-700 dark:bg-gray-950"></div>

  <div id="bu-explain" class="mt-4 text-[13px] leading-6 text-gray-600 dark:text-gray-400"></div>
  <div id="bu-timeline" class="mt-4 flex flex-wrap gap-1.5"></div>
</div>

<script>
  const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

  function encodeUrlSafe(bytes) {
    const out = []
    for (let i = 0; i < bytes.length; i += 3) {
      const b0 = bytes[i]
      const b1 = i + 1 < bytes.length ? bytes[i + 1] : 0
      const b2 = i + 2 < bytes.length ? bytes[i + 2] : 0
      const have = bytes.length - i
      const v = (b0 << 16) | (b1 << 8) | b2
      out.push(B64[(v >> 18) & 63])
      out.push(B64[(v >> 12) & 63])
      if (have >= 2) out.push(B64[(v >> 6) & 63])
      if (have === 3) out.push(B64[v & 63])
      if (have === 2) out.push('=')
      if (have === 1) { out.push('='); out.push('=') }
    }
    let s = out.join('')
    s = s.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
    return s
  }

  // Three high bytes chosen so the output contains both '+' and '/' to show the swap.
  const SAMPLE = [0xfc, 0xfd, 0xfe]
  const standard = (() => {
    const v = (SAMPLE[0] << 16) | (SAMPLE[1] << 8) | SAMPLE[2]
    return [B64[(v >> 18) & 63], B64[(v >> 12) & 63], B64[(v >> 6) & 63], B64[v & 63]].join('')
  })()
  const urlsafe = encodeUrlSafe(SAMPLE)

  const steps = [
    { phase: 'std', label: 'Standard Base64 of the three bytes: "' + standard + '". Note the "/" and "+" — both unsafe in a URL query string.' },
    { phase: 'swap', label: 'Swap "+" → "-" and "/" → "_" (positions ' + standard.indexOf('+') + ' and ' + standard.indexOf('/') + ').' },
    { phase: 'trim', label: 'Drop trailing "=" padding so the value stays intact inside a URL or filename.' },
    { phase: 'done', label: 'URL-safe result: "' + urlsafe + '". It decodes back to the same three bytes.' },
  ]

  let idx = 0
  let timer = null
  const $ = (id) => document.getElementById(id)
  const cardEl = $('bu-card'), explainEl = $('bu-explain')
  const progressEl = $('bu-progress').firstElementChild, timelineEl = $('bu-timeline')
  const playBtn = $('bu-play')

  function render() {
    const s = steps[idx]
    let shown
    if (s.phase === 'std') shown = standard
    else if (s.phase === 'swap') shown = standard.replace(/\+/g, '-').replace(/\//g, '_')
    else shown = urlsafe
    cardEl.innerHTML =
      '<div class="font-semibold text-gray-900 dark:text-white">Sample bytes 0xFC 0xFD 0xFE</div>' +
      '<div class="mt-2 text-gray-600 dark:text-gray-400">standard: <code class="font-mono text-base font-bold text-gray-900 dark:text-white">' + standard + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400">url-safe: <code class="font-mono text-base font-bold text-blue-600 dark:text-blue-400">' + shown + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400">padding kept: <code class="font-mono">' + (shown.includes('=') ? 'yes' : 'no (trimmed)') + '</code></div>'
    explainEl.textContent = (idx + 1) + '/' + steps.length + ' · ' + s.label
    progressEl.style.width = ((idx + 1) / steps.length) * 100 + '%'
    ;[...timelineEl.children].forEach((el, k) => el.classList.toggle('bg-blue-600', k === idx))
  }

  function buildTimeline() {
    timelineEl.innerHTML = steps.map((_, k) =>
      '<button class="h-2 w-2 rounded-full bg-gray-300 dark:bg-gray-600" data-i="' + k + '"></button>'
    ).join('')
    timelineEl.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => { pause(); idx = +b.dataset.i; render() }))
  }
  function play() {
    if (timer) return
    playBtn.textContent = '⏸ Pause'
    timer = setInterval(() => { if (idx >= steps.length - 1) { pause(); return } idx++; render() }, +$('bu-speed').value)
  }
  function pause() { clearInterval(timer); timer = null; playBtn.textContent = '▶ Play' }

  $('bu-reset').addEventListener('click', () => { pause(); idx = 0; render() })
  $('bu-prev').addEventListener('click', () => { pause(); idx = Math.max(0, idx - 1); render() })
  $('bu-next').addEventListener('click', () => { pause(); idx = Math.min(steps.length - 1, idx + 1); render() })
  playBtn.addEventListener('click', () => (timer ? pause() : play()))
  $('bu-speed').addEventListener('input', () => { if (timer) { pause(); play() } })

  new IntersectionObserver((es, ob) => {
    es.forEach((e) => { if (e.isIntersecting) { render(); ob.disconnect() } })
  }, { threshold: 0.4 }).observe(cardEl)

  buildTimeline()
  render()
</script>
