---
/**
 * Measures real PBKDF2 derivation time in the browser for several iteration
 * counts. The timings are measured on this device — nothing is estimated.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
    <div class="flex items-center gap-1.5">
      <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span class="text-sm font-semibold text-gray-900 dark:text-white">PBKDF2 Cost — Measured Live</span>
    </div>
    <button id="pbRun" class="ml-auto rounded-lg bg-blue-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-blue-700">Run benchmark</button>
  </div>

  <div class="mb-4 text-[13px] leading-6 text-gray-600 dark:text-gray-400">
    Iterations are the dial that decides how expensive a single password guess is. Every doubling
    doubles the attacker's work too. These numbers are <strong class="text-gray-900 dark:text-white">measured on your device
    right now</strong> with the Web Crypto API — press the button to run it.
  </div>

  <div id="pbResults" class="space-y-2"></div>

  <div id="pbSummary" class="mt-4"></div>

  <div class="mt-3 text-[11px] leading-relaxed text-gray-400 dark:text-gray-500">
    Times are single runs on your CPU, so they vary with hardware and background load. An attacker does
    not use a browser: dedicated GPUs and ASICs compute PBKDF2 orders of magnitude faster per unit
    cost, which is why the iteration count has to keep rising and why memory-hard functions like
    Argon2 and scrypt hold an advantage on that terrain.
  </div>
</div>

<script>
  const $ = (id: string) => document.getElementById(id)! as HTMLElement
  const enc = new TextEncoder()

  const COUNTS = [1000, 100000, 250000, 600000, 1000000]
  const LABELS: Record<number, string> = {
    1000: '1,000 — what too many apps still use',
    100000: '100,000 — the old common default',
    250000: '250,000 — this site\'s default',
    600000: '600,000 — current OWASP guidance',
    1000000: '1,000,000 — high-security option',
  }
  const TONES: Record<number, string> = {
    1000: 'bg-red-500',
    100000: 'bg-amber-500',
    250000: 'bg-blue-500',
    600000: 'bg-emerald-500',
    1000000: 'bg-violet-500',
  }

  const SALT = new Uint8Array(16).fill(0x5a)
  let running = false

  async function deriveOnce(iterations: number): Promise<number> {
    const base = await crypto.subtle.importKey('raw', enc.encode('correct horse battery staple'), 'PBKDF2', false, ['deriveBits'])
    const t0 = performance.now()
    await crypto.subtle.deriveBits({ name: 'PBKDF2', salt: SALT, iterations, hash: 'SHA-256' }, base, 256)
    return performance.now() - t0
  }

  const nextFrame = () => new Promise<void>(r => requestAnimationFrame(() => r()))

  async function run() {
    if (running) return
    running = true
    const btn = $('pbRun') as HTMLButtonElement
    btn.textContent = 'Running…'
    btn.disabled = true

    // Warm-up so the first measurement is not paying JIT compilation costs.
    await deriveOnce(1000)

    const results: { n: number; ms: number }[] = []
    for (const n of COUNTS) {
      $('pbResults').innerHTML = results.map(r => bar(r.n, r.ms, 0)).join('') +
        `<div class="rounded-lg border border-dashed border-gray-300 px-3 py-2 text-xs text-gray-400 dark:border-gray-700 dark:text-gray-500">Measuring ${n.toLocaleString()} iterations…</div>`
      await nextFrame()
      const ms = await deriveOnce(n)
      results.push({ n, ms })
      const max = Math.max(...results.map(r => r.ms), ms)
      $('pbResults').innerHTML = results.map(r => bar(r.n, r.ms, max)).join('') +
        `<div class="h-9 rounded-lg border border-dashed border-gray-300 dark:border-gray-700"></div>`.repeat(Math.max(0, COUNTS.length - results.length))
    }

    const max = Math.max(...results.map(r => r.ms))
    $('pbResults').innerHTML = results.map(r => bar(r.n, r.ms, max)).join('')

    const fastest = results[0]
    const owasp = results.find(r => r.n === 600000)!
    $('pbSummary').innerHTML = `<div class="rounded-lg border-l-4 border-blue-500 bg-blue-50/60 px-4 py-3 text-[13px] leading-6 text-blue-900 dark:bg-blue-950/30 dark:text-blue-200">
      Going from ${fastest.n.toLocaleString()} to ${owasp.n.toLocaleString()} iterations makes each guess
      <strong>${(owasp.ms / Math.max(fastest.ms, 0.0001)).toFixed(0)}× more expensive</strong>
      (${fastest.ms.toFixed(1)} ms → ${owasp.ms.toFixed(0)} ms per derivation here). That is the entire
      point: you buy time for the defender by spending time on every attempt, including the attacker's.
    </div>`

    btn.textContent = 'Run again'
    btn.disabled = false
    running = false
  }

  function bar(n: number, ms: number, max: number) {
    const pct = max > 0 ? Math.max(2, (ms / max) * 100) : 2
    return `<div class="flex items-center gap-3">
      <div class="w-24 shrink-0 text-right font-mono text-xs text-gray-500 dark:text-gray-400">${n.toLocaleString()}</div>
      <div class="h-7 flex-1 overflow-hidden rounded bg-gray-200 dark:bg-gray-800">
        <div class="flex h-full items-center rounded ${TONES[n]} transition-all duration-500" style="width:${pct}%">
          <span class="pl-2 font-mono text-[11px] font-semibold text-white">${ms < 10 ? ms.toFixed(2) : ms.toFixed(0)} ms</span>
        </div>
      </div>
      <div class="w-44 shrink-0 text-[11px] leading-tight text-gray-400 dark:text-gray-500">${LABELS[n]}</div>
    </div>`
  }

  $('pbResults').innerHTML = COUNTS.map(n => `
    <div class="flex items-center gap-3">
      <div class="w-24 shrink-0 text-right font-mono text-xs text-gray-500 dark:text-gray-400">${n.toLocaleString()}</div>
      <div class="h-7 flex-1 rounded border border-dashed border-gray-300 dark:border-gray-700"></div>
      <div class="w-44 shrink-0 text-[11px] leading-tight text-gray-400 dark:text-gray-500">${LABELS[n]}</div>
    </div>`).join('')

  $('pbRun').addEventListener('click', run)
</script>
