---
/**
 * Base64NotEncryption — real encode + decode of a "secret" to show that
 * Base64 is reversible by anyone, so it is encoding, not encryption.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-sm font-semibold text-gray-900 dark:text-white">Base64 is encoding, not encryption</span>
  </div>
  <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">There is no key. Anyone who has the string can decode it instantly. Watch the "secret" come straight back.</p>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <button id="bn-reset" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">⟲ Reset</button>
    <button id="bn-prev" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">‹ Prev</button>
    <button id="bn-play" class="rounded-lg border border-blue-500 bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700">▶ Play</button>
    <button id="bn-next" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">Next ›</button>
    <input id="bn-speed" type="range" min="500" max="2400" step="100" value="1300" class="ml-1 w-28 accent-blue-600" />
  </div>

  <div id="bn-progress" class="mb-4 h-1.5 w-full rounded-full bg-gray-200 dark:bg-gray-800">
    <div class="h-full rounded-full bg-blue-600 transition-all" style="width:0%"></div>
  </div>

  <div id="bn-card" class="rounded-lg border border-gray-300 bg-white p-4 text-sm dark:border-gray-700 dark:bg-gray-950"></div>

  <div id="bn-explain" class="mt-4 text-[13px] leading-6 text-gray-600 dark:text-gray-400"></div>
  <div id="bn-timeline" class="mt-4 flex flex-wrap gap-1.5"></div>
</div>

<script>
  const SECRET = 'password123'
  const encoded = btoa(SECRET)
  const decoded = atob(encoded)

  const steps = [
    { phase: 'plain', label: 'You have a value you want to "hide": "' + SECRET + '". It is just bytes.' },
    { phase: 'enc', label: 'Base64 turns it into "' + encoded + '". It looks scrambled, but that is only because it is 6-bit groups in a different alphabet.' },
    { phase: 'dec', label: 'Anyone calls decode and gets "' + decoded + '" back with no key at all. Nothing was protected.' },
    { phase: 'done', label: 'Use real encryption (AES) for confidentiality. Base64 is only for moving binary through text channels.' },
  ]

  let idx = 0
  let timer = null
  const $ = (id) => document.getElementById(id)
  const cardEl = $('bn-card'), explainEl = $('bn-explain')
  const progressEl = $('bn-progress').firstElementChild, timelineEl = $('bn-timeline')
  const playBtn = $('bn-play')

  function render() {
    const s = steps[idx]
    cardEl.innerHTML =
      '<div class="font-semibold text-gray-900 dark:text-white">Live example</div>' +
      '<div class="mt-2 text-gray-600 dark:text-gray-400">original: <code class="font-mono">' + SECRET + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400">base64: <code class="font-mono text-blue-600 dark:text-blue-400">' + encoded + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400">decoded (no key): <code class="font-mono text-rose-600 dark:text-rose-400">' + decoded + '</code></div>'
    explainEl.textContent = (idx + 1) + '/' + steps.length + ' · ' + s.label
    progressEl.style.width = ((idx + 1) / steps.length) * 100 + '%'
    ;[...timelineEl.children].forEach((el, k) => el.classList.toggle('bg-blue-600', k === idx))
  }

  function buildTimeline() {
    timelineEl.innerHTML = steps.map((_, k) =>
      '<button class="h-2 w-2 rounded-full bg-gray-300 dark:bg-gray-600" data-i="' + k + '"></button>'
    ).join('')
    timelineEl.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => { pause(); idx = +b.dataset.i; render() }))
  }
  function play() {
    if (timer) return
    playBtn.textContent = '⏸ Pause'
    timer = setInterval(() => { if (idx >= steps.length - 1) { pause(); return } idx++; render() }, +$('bn-speed').value)
  }
  function pause() { clearInterval(timer); timer = null; playBtn.textContent = '▶ Play' }

  $('bn-reset').addEventListener('click', () => { pause(); idx = 0; render() })
  $('bn-prev').addEventListener('click', () => { pause(); idx = Math.max(0, idx - 1); render() })
  $('bn-next').addEventListener('click', () => { pause(); idx = Math.min(steps.length - 1, idx + 1); render() })
  playBtn.addEventListener('click', () => (timer ? pause() : play()))
  $('bn-speed').addEventListener('input', () => { if (timer) { pause(); play() } })

  new IntersectionObserver((es, ob) => {
    es.forEach((e) => { if (e.isIntersecting) { render(); ob.disconnect() } })
  }, { threshold: 0.4 }).observe(cardEl)

  buildTimeline()
  render()
</script>
