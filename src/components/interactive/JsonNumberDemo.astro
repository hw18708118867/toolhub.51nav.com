---
/**
 * JsonNumberDemo — real JS computations that expose JSON's number pitfalls:
 * float addition error, the 2^53 safe-integer ceiling, 64-bit integer
 * precision loss, and the fact that NaN/Infinity cannot appear in JSON.
 */
---

<div class="my-10 rounded-2xl border border-gray-200 bg-gray-50/60 p-4 sm:p-5 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="text-sm font-semibold text-gray-900 dark:text-white">JSON numbers are just double-precision floats</span>
  </div>
  <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">Step through surprising results. Every value below is computed live in your browser, not hard-coded.</p>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <button id="jn-reset" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">⟲ Reset</button>
    <button id="jn-prev" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">‹ Prev</button>
    <button id="jn-play" class="rounded-lg border border-blue-500 bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700">▶ Play</button>
    <button id="jn-next" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">Next ›</button>
    <input id="jn-speed" type="range" min="600" max="2600" step="100" value="1400" class="ml-1 w-28 accent-blue-600" />
  </div>

  <div id="jn-progress" class="mb-4 h-1.5 w-full rounded-full bg-gray-200 dark:bg-gray-800">
    <div class="h-full rounded-full bg-blue-600 transition-all" style="width:0%"></div>
  </div>

  <div id="jn-card" class="rounded-lg border border-gray-300 bg-white p-4 text-sm dark:border-gray-700 dark:bg-gray-950"></div>

  <div id="jn-explain" class="mt-4 text-[13px] leading-6 text-gray-600 dark:text-gray-400"></div>
  <div id="jn-timeline" class="mt-4 flex flex-wrap gap-1.5"></div>
</div>

<script>
  const a = JSON.parse('0.1'), b = JSON.parse('0.2'), c = JSON.parse('0.3')
  const sum = a + b
  const MAX_SAFE = Number.MAX_SAFE_INTEGER
  const bigParsed = JSON.parse('9007199254740993')
  const int64 = 9223372036854775807n
  const int64Parsed = JSON.parse('9223372036854775807')
  const nanViaStringify = JSON.stringify(NaN)

  const fmt = (x) => (typeof x === 'bigint' ? x.toString() : String(x))

  const steps = [
    {
      title: '0.1 + 0.2',
      input: '0.1 + 0.2',
      output: fmt(sum),
      expected: fmt(c),
      same: sum === c,
      note: 'The sum is 0.30000000000000004, not 0.3. Binary floats cannot represent 0.1 exactly, so never compare money with ==.',
    },
    {
      title: 'Safe integer ceiling (2^53 − 1)',
      input: 'Number.MAX_SAFE_INTEGER',
      output: fmt(MAX_SAFE),
      expected: 'largest integer with no precision loss',
      same: true,
      note: 'Above 9007199254740991 the integer you put in is not the integer you get out, because doubles only have 53 bits of mantissa.',
    },
    {
      title: 'Past the ceiling',
      input: 'JSON.parse("9007199254740993")',
      output: fmt(bigParsed),
      expected: '9007199254740993',
      same: false,
      note: '9007199254740993 parses to 9007199254740992. The last digit is silently lost — round-trip JSON of a big int is not exact.',
    },
    {
      title: '64-bit integers (int64)',
      input: 'JSON.parse("9223372036854775807")',
      output: fmt(int64Parsed),
      expected: '9223372036854775807',
      same: false,
      note: 'A database bigint like 9223372036854775807 comes back as 9223372036854776000. JSON has no integer type, so databases ship IDs as strings, not numbers.',
    },
    {
      title: 'NaN cannot be JSON',
      input: 'JSON.stringify(NaN)',
      output: nanViaStringify,
      expected: 'throws / "null"',
      same: nanViaStringify === 'null',
      note: 'JSON.stringify turns NaN into null, and JSON.parse("NaN") throws. There is no NaN or Infinity in JSON — model missing numbers explicitly.',
    },
  ]

  let idx = 0
  let timer = null
  const $ = (id) => document.getElementById(id)
  const cardEl = $('jn-card'), explainEl = $('jn-explain')
  const progressEl = $('jn-progress').firstElementChild, timelineEl = $('jn-timeline')
  const playBtn = $('jn-play')

  function render() {
    const s = steps[idx]
    const okCls = s.same
      ? 'text-emerald-700 dark:text-emerald-300'
      : 'text-rose-700 dark:text-rose-300'
    cardEl.innerHTML =
      '<div class="font-semibold text-gray-900 dark:text-white">' + s.title + '</div>' +
      '<div class="mt-2 text-gray-600 dark:text-gray-400"><span class="text-gray-500 dark:text-gray-500">input:</span> <code class="font-mono">' + s.input + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400"><span class="text-gray-500 dark:text-gray-500">result:</span> <code class="font-mono ' + okCls + '">' + s.output + '</code></div>' +
      '<div class="mt-1 text-gray-600 dark:text-gray-400"><span class="text-gray-500 dark:text-gray-500">expected:</span> <code class="font-mono">' + s.expected + '</code></div>'
    explainEl.textContent = (idx + 1) + '/' + steps.length + ' · ' + s.note
    progressEl.style.width = ((idx + 1) / steps.length) * 100 + '%'
    ;[...timelineEl.children].forEach((el, k) => el.classList.toggle('bg-blue-600', k === idx))
  }

  function buildTimeline() {
    timelineEl.innerHTML = steps.map((_, k) =>
      '<button class="h-2 w-2 rounded-full bg-gray-300 dark:bg-gray-600" data-i="' + k + '"></button>'
    ).join('')
    timelineEl.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => { pause(); idx = +b.dataset.i; render() }))
  }

  function play() {
    if (timer) return
    playBtn.textContent = '⏸ Pause'
    timer = setInterval(() => {
      if (idx >= steps.length - 1) { pause(); return }
      idx++; render()
    }, +$('jn-speed').value)
  }
  function pause() { clearInterval(timer); timer = null; playBtn.textContent = '▶ Play' }

  $('jn-reset').addEventListener('click', () => { pause(); idx = 0; render() })
  $('jn-prev').addEventListener('click', () => { pause(); idx = Math.max(0, idx - 1); render() })
  $('jn-next').addEventListener('click', () => { pause(); idx = Math.min(steps.length - 1, idx + 1); render() })
  playBtn.addEventListener('click', () => (timer ? pause() : play()))
  $('jn-speed').addEventListener('input', () => { if (timer) { pause(); play() } })

  new IntersectionObserver((es, ob) => {
    es.forEach((e) => { if (e.isIntersecting) { render(); ob.disconnect() } })
  }, { threshold: 0.4 }).observe(cardEl)

  buildTimeline()
  render()
</script>
