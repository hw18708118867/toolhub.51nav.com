---
/**
 * HeroDemo — a live, usable Base64 encoder embedded in the homepage hero.
 * Shows the product instead of describing it. Works offline, no framework.
 */
---

<div class="rounded-2xl bg-gray-900 border border-gray-800 shadow-2xl shadow-blue-500/10 overflow-hidden">
  <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-gray-800">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
      <span class="ml-2 text-xs font-medium text-gray-300">Try it live</span>
    </div>
    <span class="text-[10px] uppercase tracking-wider text-green-400 bg-green-500/10 px-2 py-1 rounded-full">Runs locally</span>
  </div>

  <div class="p-4 sm:p-5">
    <div class="flex items-center justify-between mb-2">
      <label for="hero-demo-input" class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">Your text</label>
      <span class="text-[10px] text-gray-600">editable</span>
    </div>
    <textarea id="hero-demo-input" rows="2" class="w-full bg-gray-950 border border-gray-800 rounded-lg px-3 py-2.5 font-mono text-sm text-gray-100 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500/50" spellcheck="false">Hello, world! 👋</textarea>

    <div class="flex items-center justify-between mt-4 mb-2">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">Base64 output</span>
      <button id="hero-demo-copy" class="text-[11px] font-medium text-blue-400 hover:text-blue-300 transition-colors">Copy</button>
    </div>
    <pre id="hero-demo-output" class="w-full min-h-[3rem] bg-gray-950 border border-gray-800 rounded-lg px-3 py-2.5 font-mono text-sm text-green-400 break-all whitespace-pre-wrap"></pre>

    <div class="flex items-center justify-between gap-3 mt-4">
      <p class="text-[11px] text-gray-600">Nothing is uploaded. Ever.</p>
      <a href="/tools/base64-converter/" data-ga="hero_demo_open_tool" class="shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold text-blue-400 hover:text-blue-300 transition-colors">
        Full tool
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>

<script>
  const input = document.getElementById('hero-demo-input') as HTMLTextAreaElement | null
  const output = document.getElementById('hero-demo-output')
  const copy = document.getElementById('hero-demo-copy')

  function toBase64(str: string) {
    const bytes = new TextEncoder().encode(str)
    let binary = ''
    for (const b of bytes) binary += String.fromCharCode(b)
    return btoa(binary)
  }

  function render() {
    if (!input || !output) return
    output.textContent = input.value ? toBase64(input.value) : 'Start typing to see the result...'
  }

  input?.addEventListener('input', () => {
    render()
    document.dispatchEvent(new CustomEvent('ga-event', { detail: { name: 'hero_demo_interact' } }))
  })
  copy?.addEventListener('click', async () => {
    if (!output?.textContent) return
    try {
      await navigator.clipboard.writeText(output.textContent)
      copy.textContent = 'Copied'
      setTimeout(() => { if (copy) copy.textContent = 'Copy' }, 1600)
      document.dispatchEvent(new CustomEvent('ga-event', { detail: { name: 'hero_demo_copy' } }))
    } catch { /* clipboard unavailable in insecure context */ }
  })

  render()
</script>
